{
  "name": "review-skill",
  "version": "0.1.0",
  "description": "Compile Markdown Agent Skills into type-safe, token-aware runtime artifacts",
  "type": "module",
  "bin": {
    "review-skill": "./bin/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "bin"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/qiao-coding/review-skill"
  },
  "homepage": "https://github.com/qiao-coding/review-skill#readme",
  "dependencies": {
    "fast-glob": "^3.3.3",
    "unified": "^11.0.5",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "mdast-util-to-string": "^4.0.0",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
