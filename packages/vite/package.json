{
  "name": "@review-skill/vite",
  "version": "0.1.1",
  "description": "Vite plugin for review-skill — skills as first-class typed modules (@skill/* virtual imports + auto-compile)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./client.d.ts"
    }
  },
  "files": [
    "dist",
    "client.d.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p .",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "vite-plugin",
    "skill",
    "markdown",
    "agent"
  ],
  "dependencies": {
    "review-skill": "file:../review-skill"
  },
  "peerDependencies": {
    "vite": ">=5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vite": "^5.4.0",
    "vitest": "^4.1.10"
  }
}
